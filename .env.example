# Copy this file to .env and add your own secret key.
# Never commit or share the real .env file.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
APP_BASE_URL=http://localhost:4318

# Google Identity Services OAuth 2.0 Web Client ID.
# Add http://localhost:4318 and your public HTTPS URL as authorized JavaScript origins.
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Optional storage location for a single-instance deployment with a persistent disk.
# NEXTMOVE_DB_FILE=/var/data/nextmove-db.json

# Optional: email sender for future account/support messages.
# RESEND_API_KEY=your_resend_api_key_here
# CONSENT_FROM_EMAIL=NextMove <noreply@yourdomain.com>
